# data — never commit inventory
invos-*.json
invos-backup.json
*.db
*.db-wal
*.db-shm

# build output
invos-server
invos-server-*
invos.exe
/bin/
/dist/

# local noise
.DS_Store
Thumbs.db

# node deps for the UI tests
test/ui/node_modules/
invos-test.exe
invos.exe~
invos-stale.exe
invos-recover.exe
test/ui/*.png
invos-bench.exe
invos-shot.exe
invos-upd.exe
